---
// Un iPhone dibujado con CSS (marco propio) con capturas reales de HaNet adentro.
// `screens` son las pantallas que lleva; la activa se elige con data-screen en
// el contenedor (el script del landing la cambia). "notas" son dos capturas:
// la nota tapada y, un momento después, destapada.
import { SCREEN_ALT, type Screen } from '../data/content';

interface Props { screens: Screen[]; active: Screen; eager?: boolean; class?: string }
const { screens, active, eager = false, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imgs = screens.flatMap(s => (s === 'notas'
  ? [{ screen: s, file: 'notas-tapada', part: 'a' }, { screen: s, file: 'notas-destapada', part: 'b' }]
  : [{ screen: s, file: s, part: '' }]));
---
<div class:list={['phone', cls]} data-phone data-screen={active}>
  <div class="phone__btn phone__btn--l1" aria-hidden="true"></div>
  <div class="phone__btn phone__btn--l2" aria-hidden="true"></div>
  <div class="phone__btn phone__btn--l3" aria-hidden="true"></div>
  <div class="phone__btn phone__btn--r1" aria-hidden="true"></div>
  <div class="phone__frame" aria-hidden="true"></div>
  <div class="phone__screen">
    {imgs.map(i => (
      <img
        src={`${base}/screens/${i.file}.webp`}
        alt={SCREEN_ALT[i.file]}
        width="393" height="852"
        loading={eager && i.screen === active ? 'eager' : 'lazy'}
        decoding="async"
        data-shot={i.screen}
        data-part={i.part || undefined}
      />
    ))}
    <div class="phone__status" aria-hidden="true">
      <span>9:41</span>
      <span class="phone__icons">
        <svg width="18" height="12" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" fill="currentColor"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1" fill="currentColor"></rect><rect x="10" y="3" width="3" height="9" rx="1" fill="currentColor"></rect><rect x="15" y="0" width="3" height="12" rx="1" fill="currentColor"></rect></svg>
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1.5 4.5a9.5 9.5 0 0 1 13 0M4 7.3a6 6 0 0 1 8 0"></path><circle cx="8" cy="10.2" r="1.2" fill="currentColor" stroke="none"></circle></svg>
        <span class="phone__battery"><span></span></span>
      </span>
    </div>
    <div class="phone__island" aria-hidden="true"></div>
    <div class="phone__home" aria-hidden="true"></div>
  </div>
</div>
